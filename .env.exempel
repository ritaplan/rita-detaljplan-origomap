# Inställningar för detaljplaner i webbkartan. Kopiera till .env och ändra:
#
#   cp .env.exempel .env
#
# Värden med blanksteg eller citationstecken ska stå inom dubbla citationstecken. .env läses både av docker compose och som
# skalskript, så använd bara enkla NAMN=värde-rader.
# .env checkas aldrig in (där hamnar också lösenorden som skripten skapar). Alla rader har ett förvalt värde utom de som
# är markerade med OBLIGATORISK. Se docs/konfiguration.md för en längre förklaring.

# ---- Databasen -------------------------------------------------------------------------------------------------------
# Kommandot som kör psql som databasens administratör och läser SQL från stdin. Det används bara av skripten i databas/.
# OBLIGATORISK. Två vanliga former:
#   PostgreSQL på en annan server:   PSQL="psql -h db.exempelkommun.se -U gisadmin -d gis"
#       (lösenord via PGPASSWORD eller filen ~/.pgpass)
#   PostGIS i en Docker-behållare:   PSQL="docker exec -i postgis psql -U gisadmin -d gis"
PSQL="docker exec -i postgis psql -U gisadmin -d gis"

# Databasens namn, så som karttjänsterna når den. DB_HOST är värdnamnet i Dockernätverket DB_NETWORK (för en behållare
# är det dess namn; för en extern server dess adress, och då behövs inget särskilt nätverk: lämna DB_NETWORK som det är
# eller skapa ett tomt med "docker network create db").
DB_NETWORK=postgis_default
DB_HOST=postgis
DB_PORT=5432
DB_NAME=gis
# require = krypterad anslutning (de flesta databaser kräver det mellan behållare). disable = okrypterad.
DB_SSLMODE=require

# ---- Planerna --------------------------------------------------------------------------------------------------------
# Schemat där Rita Detaljplan lägger planerna (Ny detaljplan, PostGIS). OBLIGATORISK.
PLAN_SCHEMA=detaljplaner
# Planernas koordinatsystem (EPSG-kod, bara siffrorna): SWEREF 99 TM = 3006, 12 00 = 3007, 13 30 = 3008 och så vidare.
PLAN_EPSG=3006
# Kommunens utbredning i planernas koordinatsystem: minx,miny,maxx,maxy. Vektorrutorna levereras bara inom den.
# Ta gärna något för stort: tomma rutor kostar nästan ingenting. OBLIGATORISK för vektorrutor.
PLAN_EXTENT=120000,6100000,200000,6200000
# Vilka planer som är offentliga: en SQL-lista med statusvärden. Förvalt: antagna planer och planer med laga kraft.
# Andra värden som finns: påbörjad, samråd, granskning, överklagad, tillsyn, upphävd, avslutad.
PUBLIC_STATUSES="'antagen','laga kraft'"

# ---- Tjänsterna ------------------------------------------------------------------------------------------------------
# Vilka tjänster utöver GeoServer som startas: qgis (QGIS Server), exempel (exempelkartans webbserver). Tomt = bara GeoServer.
COMPOSE_PROFILES=
# Exempelmiljöns webbserver (profilen exempel): vilken konfiguration och vilken Origo-karta den visar. WEB_CONF är web.conf
# (bara GeoServer) eller web-med-qgis.conf; WEB_ROOT är mappen med Origo-kartan (förvalt exempelkartan i det här repot).
WEB_CONF=web.conf
WEB_ROOT=./exempelkarta
# Portar på den här datorn (bara 127.0.0.1: nås utifrån via din webbserver, se docs/kom-igang.md).
# GEOSERVER_ADMIN_PORT är porten din webbserver skickar /geoserver/ till.
WEB_PORT=8090
GEOSERVER_ADMIN_PORT=8081
# Versioner. Pröva en ny version i en testmiljö först.
GEOSERVER_IMAGE=docker.osgeo.org/geoserver:3.0.2
QGIS_SERVER_IMAGE=qgis/qgis-server:4.2.3-resolute
# Minne. GeoServer behöver ungefär 600 MB, QGIS Server 250 MB.
GEOSERVER_MEMORY=1g
GEOSERVER_JAVA_OPTS="-Xms128m -Xmx640m"
QGIS_SERVER_MEMORY=512m

# KARTA_RO_PASSWORD och GEOSERVER_ADMIN_PASSWORD läggs till av databas/skapa_roll.sh och forbered.sh. Skriv dem inte här.
